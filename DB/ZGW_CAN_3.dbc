CM_ SG_ 514 CSB_SDAT_Year "UTC year minus 2000; ZGW saturates values above 2063 to raw 63.";
CM_ SG_ 514 CSB_SDAT_Millisecond "UTC millisecond encoded with 4 ms resolution.";
CM_ SG_ 514 CSB_SDAT_TimeSource "0=default compile-time UTC, 1=UDS RoutineControl set time, 2=gPTP master, 3=invalid/unavailable.";
CM_ SG_ 514 CSB_SDAT_UtcValid "1 when UTC/calendar fields are valid for display.";
CM_ SG_ 514 CSB_SDAT_DefaultTime "1 when UTC comes from the compile-time default and shall be shown as not synchronized.";
CM_ SG_ 514 CSB_SDAT_NvmRestored "1 when UTC was restored from NvM; no powered-off elapsed time is added without an external RTC.";
VAL_ 514 CSB_SDAT_TimeSource 0 "DefaultCompileTime" 1 "UdsRoutine" 2 "GptpMaster" 3 "Invalid" ;
VAL_ 514 CSB_SDAT_UtcValid 0 "Invalid" 1 "Valid" ;
VAL_ 514 CSB_SDAT_DefaultTime 0 "NotDefault" 1 "DefaultCompileTime" ;
VAL_ 514 CSB_SDAT_NvmRestored 0 "NotRestored" 1 "RestoredFromNvM" ;
