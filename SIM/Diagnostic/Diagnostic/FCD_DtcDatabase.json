{
  "database": "FCD_DTC_DATABASE",
  "version": 2,
  "updated_for": "Ethernet production diagnostics and snapshot data",
  "storage": {
    "origin": "primary",
    "persistent_nvm": true,
    "nvm_block": "DEM_NVM_BLOCK_ID_PRIMARY",
    "snapshot_max_bytes": 256
  },
  "snapshot_layouts": {
    "common_v2": {
      "length": 22,
      "byte_order": "big_endian",
      "fields": [
        {"name": "vehicle_time_ns", "offset": 0, "size": 8, "type": "uint64"},
        {"name": "utc_time_ns", "offset": 8, "size": 8, "type": "uint64"},
        {"name": "utc_valid", "offset": 16, "size": 1, "type": "uint8"},
        {"name": "time_source", "offset": 17, "size": 1, "type": "uint8"},
        {"name": "mcu_core_temperature_cdeg_c", "offset": 18, "size": 2, "type": "sint16"},
        {"name": "snapshot_version", "offset": 20, "size": 1, "type": "uint8", "value": 2},
        {"name": "snapshot_kind", "offset": 21, "size": 1, "type": "uint8", "values": {"0": "common", "1": "ethernet"}}
      ]
    },
    "ethernet_v2": {
      "extends": "common_v2",
      "length": 71,
      "byte_order": "big_endian",
      "fields": [
        {"name": "local_ip_addr", "offset": 22, "size": 4, "type": "ipv4"},
        {"name": "remote_ip_addr", "offset": 26, "size": 4, "type": "ipv4"},
        {"name": "local_port", "offset": 30, "size": 2, "type": "uint16"},
        {"name": "remote_port", "offset": 32, "size": 2, "type": "uint16"},
        {"name": "so_con_id", "offset": 34, "size": 1, "type": "uint8"},
        {"name": "ethernet_diag_connection_id", "offset": 35, "size": 1, "type": "uint8"},
        {"name": "protocol", "offset": 36, "size": 1, "type": "uint8", "values": {"0": "UDP", "1": "TCP"}},
        {"name": "link_up", "offset": 37, "size": 1, "type": "uint8"},
        {"name": "rx_error_counter", "offset": 38, "size": 4, "type": "uint32"},
        {"name": "tx_error_counter", "offset": 42, "size": 4, "type": "uint32"},
        {"name": "dma_error_counter", "offset": 46, "size": 4, "type": "uint32"},
        {"name": "tcp_unexpected_close_counter", "offset": 50, "size": 4, "type": "uint32"},
        {"name": "socket_open_fail_counter", "offset": 54, "size": 4, "type": "uint32"},
        {"name": "link_down_transition_counter", "offset": 58, "size": 4, "type": "uint32"},
        {"name": "listen_socket_id", "offset": 62, "size": 4, "type": "sint32"},
        {"name": "active_socket_id", "offset": 66, "size": 4, "type": "sint32"},
        {"name": "soad_state", "offset": 70, "size": 1, "type": "uint8", "values": {"0": "closed", "1": "open", "2": "connected"}}
      ]
    }
  },
  "dtcs": [
    {"dtc": "0x010101", "event_id": "DEM_EVENT_ID_MCUSM_SW_ERROR", "name": "MCU safety manager software error", "persistent_nvm": true, "snapshot_layout": "mcu_sm_with_common_v2_tail"},
    {"dtc": "0x023000", "event_id": "DEM_EVENT_ID_CODING_ECU_NOT_CODED", "name": "ECU not coded", "persistent_nvm": true, "snapshot_layout": "common_v2"},
    {"dtc": "0x023001", "event_id": "DEM_EVENT_ID_CODING_INVALID", "name": "Coding invalid", "persistent_nvm": true, "snapshot_layout": "common_v2"},
    {"dtc": "0x022000", "event_id": "DEM_EVENT_ID_ETH_LINK_LOST", "name": "Ethernet link lost", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x022001", "event_id": "DEM_EVENT_ID_ETH_CTRL_DMA_FAILURE", "name": "Ethernet controller or DMA failure", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x022002", "event_id": "DEM_EVENT_ID_ETH_RX_COMM_FAILURE", "name": "Ethernet RX communication failure", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x022003", "event_id": "DEM_EVENT_ID_ETH_TX_COMM_FAILURE", "name": "Ethernet TX communication failure", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x022004", "event_id": "DEM_EVENT_ID_ETH_TCP_UNEXPECTED_TERMINATION", "name": "TCP unexpected termination", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x022005", "event_id": "DEM_EVENT_ID_ETH_TCP_ESTABLISHMENT_FAILURE", "name": "TCP establishment failure", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x022006", "event_id": "DEM_EVENT_ID_ETH_UDP_SUPERVISION_TIMEOUT", "name": "UDP supervision timeout", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x022007", "event_id": "DEM_EVENT_ID_ETH_SERVICE_AVAILABILITY_FAILURE", "name": "Ethernet service availability failure", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x022008", "event_id": "DEM_EVENT_ID_ETH_DOIP_COMM_FAILURE", "name": "DoIP communication failure", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x022009", "event_id": "DEM_EVENT_ID_ETH_PARTNER_COMM_TERMINATED", "name": "Ethernet communication partner terminated", "persistent_nvm": true, "snapshot_layout": "ethernet_v2"},
    {"dtc": "0x021000-0x0210FF", "event_id": "DEM_EVENT_ID_GATEWAY_RX_MESSAGE_TIMEOUT_FIRST..LAST", "name": "Gateway RX message timeout", "persistent_nvm": true, "snapshot_layout": "common_v2"}
  ]
}
